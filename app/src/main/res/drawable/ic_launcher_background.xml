    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="0" android:endY="108">
                <item android:offset="0" android:color="@color/launcher_ground" />
                <item android:offset="0.48" android:color="@color/launcher_horizon" />
                <item android:offset="1" android:color="@color/launcher_ground" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
