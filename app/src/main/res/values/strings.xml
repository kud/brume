    <string name="about_title">About Brume</string>
    <string name="about_what">Sounds for comfort and sleep. A journal to see how things go over time.</string>
    <string name="about_disclaimer">It\'s not a treatment, and it doesn\'t replace a doctor. Brume is not a medical device.</string>
    <string name="about_privacy">Everything stays on this phone. Brume has no internet access, no account and no cloud backup. Data leaves only in an export you save yourself.</string>
    <string name="settings_title">Settings</string>
    <string name="settings_night">Night hours, 22:00–06:00</string>
    <string name="settings_night_summary">Dark and dim at night, whatever the system theme, and opens on Listen.</string>
    <string name="doctor_title">When to see a doctor</string>
    <string name="doctor_intro">See a doctor if any of this is true for you:</string>
    <string name="doctor_1">Your hearing dropped suddenly, in the last month. (Today)</string>
    <string name="doctor_2">You\'ve had sudden dizziness or spinning with it. (Today)</string>
    <string name="doctor_3">It started after a blow to the head. (Today)</string>
    <string name="doctor_4">It beats in time with your heart. (Within two weeks)</string>
    <string name="doctor_5">It\'s in one ear only, and that\'s new or getting worse. (Within two weeks)</string>
    <string name="doctor_6">Your face feels weak or numb, or there\'s another sudden change in your body. (Today)</string>
    <string name="support_line">If you\'re thinking about ending your life, call 3114 (France, free, day and night) or 112.</string>
