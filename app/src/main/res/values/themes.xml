<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Brume" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/dawn_ground</item>
    </style>

    <!--
        Launch screen (core-splashscreen, Android 10 and up alike): the emblem (Sacha's logo, as the launcher's vector),
        still, on the ground Listen's first frame paints (dawn by day, true black at night), so the
        hand-off never flashes. The in-app intro (ui/launch) takes over from it at the same place.
    -->
    <style name="Theme.Brume.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Brume</item>
    </style>
</resources>
